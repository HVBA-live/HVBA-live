# Stage 1: Build de React-app
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_KEYCLOAK_URL=http://localhost:8080
ARG VITE_KEYCLOAK_REALM=hvba
ARG VITE_KEYCLOAK_CLIENT_ID=hvba-frontend
ARG VITE_API_URL=http://localhost:5292

ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL
ENV VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Stage 2: Serveer met Caddy
FROM caddy:2-alpine
WORKDIR /srv
COPY --from=build /app/dist /srv

CMD ["caddy", "file-server", "--root", "/srv", "--listen", ":80", "--browse=false"]